PORT=5001
NODE_ENV=development
APP_NAME=SolveSpace Technologies API
APP_VERSION=2.0.0

# ==========================================
# Amazon Web Services (AWS) S3 Configuration
# ==========================================
# Resumes will be stored in: s3://jobportalbyaditya/resumes/{applicationId}/{uniqueFilename}.pdf
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_S3_BUCKET=jobportalbyaditya

# Optional: Set to true if testing frontend/backend locally without live AWS credentials
ALLOW_MOCK_S3=false
